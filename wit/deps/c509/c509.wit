package app:c509;

interface c509 {
    decode: func(bytes: list<u8>) -> result<string, string>;
    decode-sequence: func(bytes: list<u8>) -> result<string, string>;
    encode: func(json-string: string) -> result<list<u8>, string>;
    encode-sequence: func(json-string: string) -> result<list<u8>, string>;
}